<a class="char-stat-button skill" data-action="rollCustomSkill" data-item-id="{{item.id}}">
    <div class="label">
        <span>{{item.name}}</span>
        {{#if (gte item.system.modifiedValue 0)}}
            <span>+{{item.system.modifiedValue}}</span>
        {{else}}
            <span>{{item.system.modifiedValue}}</span>
        {{/if}}
    </div>
    {{#if (or item.system.isProfession item.system.isPickup item.system.isLearned)}}
        <div class="skill-icons">
            {{#if item.system.isProfession}}
                <span><i>{{localize 'WITCHER.skills.profession'}}</i></span>
            {{/if}}
            {{#if item.system.isPickup}}
                <span><i>{{localize 'WITCHER.skills.pickup'}}</i></span>
            {{/if}}
            {{#if item.system.isLearned}}
                <span><i>{{localize 'WITCHER.skills.learn'}}</i></span>
            {{/if}}
        </div>
    {{/if}}
</a>