<div data-type="associatedItem">
    <table class="item-bottom-table" data-type="associatedItem">
        <tr data-type="associatedItem">
            <th data-type="associatedItem">
                {{#if associatedItemView.uuid}}
                    <a data-type="associatedItem" class="remove-associated-item"
                        title="{{localize "WITCHER.Item.RemoveAssociatedItem"}}">
                        <i class="fas fa-minus"></i></a>

                {{else}}
                    <a data-type="associatedItem" class="add-associated-item"
                        title="{{localize "WITCHER.Item.AddAssociatedItem"}}">
                        <i class="fas fa-plus"></i></a>
                {{/if}}
            </th>
            <th data-type="associatedItem">
                {{#if associatedItemView.available}}
                    <header class="sheet-header" data-type="associatedItem">
                        <img data-type="associatedItem" class="profile-img" src="{{associatedItemView.img}}"
                            data-edit="img" title="{{associatedItemView.name}}" />
                    </header>
                {{/if}}
            </th>
            <th data-type="associatedItem">
                {{#if associatedItemView.available}}
                    <input class="inline-edit item-quantity" name="system.resultQuantity" type="text"
                        value="{{item.system.resultQuantity}}" data-dtype="Number" />
                {{/if}}
            </th>
            <th data-type="associatedItem">
                <div class="description" data-type="associatedItem">
                    {{#if associatedItemView.available}}
                        <label data-type="associatedItem"
                            class="label-info"><b>{{associatedItemView.name}}</b></label>
                        {{{associatedItemView.description}}}
                    {{else}}
                        {{localize "WITCHER.craft.AssociatedItemMissing"}}
                    {{/if}}
                </div>
            </th>
        </tr>
    </table>
</div>