<section class="scrollable">
    {{>"systems/TheWitcherTRPG-RB-Version/templates/partials/item-header.hbs"}}
    <div class="description">
        <textarea rows=5 name="system.description">{{data.description}}</textarea>
    </div>
    <div class='storedWeight'>
        <input type="text" value="{{data.storedWeight}}" disabled />
        <span>
            /
        </span>
        <input type="number" name="system.carry" value="{{item.system.carry}}" data-dtype="Number" />
    </div>
    {{#if portableTemplate}}<p>{{localize "WITCHER.Container.templateHelp"}}</p>{{/if}}
    {{#if data.contentIncomplete}}<p role="alert">{{localize "WITCHER.Container.incompleteWeight"}}</p>{{/if}}
    {{#each data.itemContent as |storedItem|}}
        <div class="container-item" data-uuid="{{storedItem.uuid}}" data-missing="{{storedItem.missing}}">
            <div class="header">
                <input type="text" value="{{storedItem.name}}" disabled />
                {{#unless storedItem.portable}}
                    {{#unless storedItem.missing}}
                        <a class="open-contained-item" data-uuid="{{storedItem.uuid}}" title="{{localize "WITCHER.Container.openItem"}}"><i class="fas fa-edit"></i></a>
                    {{/unless}}
                    <a class="remove-item" data-uuid="{{storedItem.uuid}}"
                        title="{{#if storedItem.missing}}{{localize "WITCHER.Container.removeBrokenLink"}}{{else}}{{localize "WITCHER.Container.extractItem"}}{{/if}}">
                        <i class="fa-solid fa-arrow-up-from-bracket"></i></a>
                {{/unless}}
            </div>
            <item-content class="item-content">
                <div class="quantity-weight">
                    <quantity>
                        <label>{{localize "WITCHER.Item.Quantity"}}</label>
                        <input type="text" value="{{storedItem.quantity}}" disabled />
                    </quantity>
                    <weight>
                        <label>{{localize "WITCHER.Item.Weight"}}</label>
                        <input type="text" value="{{storedItem.weight}}" disabled />
                    </weight>
                </div>
                {{#if storedItem.description}}
                    <description>
                        <textarea rows=5 disabled>{{storedItem.description}}</textarea>
                    </description>
                {{/if}}
            </item-content>
        </div>
    {{/each}}
</section>