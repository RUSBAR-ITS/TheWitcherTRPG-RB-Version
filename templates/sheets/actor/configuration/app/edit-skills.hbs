<div class="edit-stats modifier-list scrollable">
    <div class="modifier-row modifier-columns" aria-hidden="true">
        <span>{{localize 'WITCHER.skills.name'}}</span>
        <span>{{localize 'WITCHER.Editor.base'}}</span>
        <span>{{localize 'WITCHER.Editor.effective'}}</span>
        <span>{{localize 'WITCHER.Editor.cap'}}</span>
        <span>{{localize 'WITCHER.Editor.action'}}</span>
    </div>
    {{#with (lookup system.skills skillKey) as |skillGroup|}}
        {{#each skillGroup as |skill skillName|}}
            <div class="modifier-entry" data-skill="{{skillName}}">
                <div class="modifier-row">
                    <span class="modifier-name">{{localize skill.label}}</span>
                    <input name="system.skills.{{@root.skillKey}}.{{skillName}}.value" type="number" value="{{skill.value}}" data-dtype="Number"
                        aria-label="{{localize skill.label}}: {{localize 'WITCHER.Effect.Modifier.savedBase'}}" />
                    <output class="modifier-value" title="{{localize 'WITCHER.Effect.Modifier.currentValue'}}">{{skill.currentValue}}</output>
                    <input name="system.skills.{{@root.skillKey}}.{{skillName}}.baseCap" type="number" value="{{skill.baseCap}}" data-dtype="Number"
                        title="{{localize 'WITCHER.Effect.Modifier.baseCapHint'}}"
                        aria-label="{{localize skill.label}}: {{localize 'WITCHER.Effect.Modifier.baseCap'}}" />
                    <div class="modifier-actions">
                        {{#if @root.canPurchase}}
                            <button type="button" data-action="level-up" data-skill="{{skillName}}">{{localize 'WITCHER.skills.levelUp'}}</button>
                        {{/if}}
                    </div>
                </div>
                <details class="modifier-details">
                    <summary>{{localize 'WITCHER.Editor.details'}}</summary>
                    <div class="modifier-flags">
                        <label><input class="skill-checkbox" type="checkbox" name="system.skills.{{@root.skillKey}}.{{skillName}}.isProfession" {{checked skill.isProfession}} />{{localize 'WITCHER.skills.profession'}}</label>
                        <label><input class="skill-checkbox" type="checkbox" name="system.skills.{{@root.skillKey}}.{{skillName}}.isPickup" {{checked skill.isPickup}} />{{localize 'WITCHER.skills.pickup'}}</label>
                        <label><input class="skill-checkbox" type="checkbox" name="system.skills.{{@root.skillKey}}.{{skillName}}.isLearned" {{checked skill.isLearned}} />{{localize 'WITCHER.skills.learn'}}</label>
                    </div>
                    {{#if skill.activeEffectModifiers}}
                        <p class="skill-modifiers">{{localize 'WITCHER.activeEffect.tab'}}: {{skill.activeEffectModifiers}}</p>
                    {{/if}}
                </details>
            </div>
        {{/each}}
    {{/with}}
</div>
