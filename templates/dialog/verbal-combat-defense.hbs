<form class="{{cssClass}}" autocomplete="off">
    <h1>{{localize "WITCHER.verbalCombat.Title"}}</h1>
    <div>
        {{#each defenses as |verbalData verbalName|}}
            <div>
                <label>
                    <input name="verbalCombat" type="radio" value="{{verbalName}}" data-group="Defenses" />
                    {{localize (concat verbalData.name)}}
                </label>
            </div>
        {{/each}}
        <label>{{localize "WITCHER.Dialog.customModifier"}}: <input name="customModifiers" value=0></label>
    </div>
</form>
